          {
            "name": "calidad_financiera",
            "dataType": "string",
            "description": "Reglas exploratorias: presupuesto positivo menor a 1000 o >=300 millones; ingreso positivo <=100 o >=5 mil millones; ROI >=100 (10,000%); presupuesto igual a ingreso. Sin alertas no significa verificado. No se exige tener ambos importes.",
            "lineageTag": "43035acc-7d8a-5b6c-a387-b2026644ca2d",
            "sourceColumn": "calidad_financiera",
            "summarizeBy": "none"
          }
        ],
        "lineageTag": "e00aef31-b3ff-53f8-959f-ca74f0907cd0",
        "measures": [
          {
            "name": "Presupuesto total",
            "description": "Agregación de valores conocidos; nulos no se sustituyen por cero. ROI y diferencia bruta no equivalen a beneficio neto.",
            "expression": "SUM('fact_peliculas'[budget])",
            "formatString": "$#,0",
            "lineageTag": "c674cffb-aab1-5da4-8e3c-78d3fa21911c"
          },
          {
            "name": "Ingresos totales",
            "description": "Agregación de valores conocidos; nulos no se sustituyen por cero. ROI y diferencia bruta no equivalen a beneficio neto.",
            "expression": "SUM('fact_peliculas'[revenue])",
            "formatString": "$#,0",
            "lineageTag": "a45d9f0b-1269-55f5-b953-b9a8da476674"
          },
          {
            "name": "Calificación promedio",
            "description": "Agregación de valores conocidos; nulos no se sustituyen por cero. ROI y diferencia bruta no equivalen a beneficio neto.",
            "expression": "AVERAGE('fact_peliculas'[vote_average])",
            "formatString": "0.00",
            "lineageTag": "a7c8422b-f215-5147-968d-74670631524e"
          },
          {
            "name": "Votos totales",
            "description": "Agregación de valores conocidos; nulos no se sustituyen por cero. ROI y diferencia bruta no equivalen a beneficio neto.",
            "expression": "SUM('fact_peliculas'[vote_count])",
            "formatString": "#,0",
            "lineageTag": "1f7fc9b4-b1eb-5266-a602-acaa398c3356"
          },
          {
            "name": "Duración promedio",
            "description": "Agregación de valores conocidos; nulos no se sustituyen por cero. ROI y diferencia bruta no equivalen a beneficio neto.",
            "expression": "AVERAGE('fact_peliculas'[runtime])",
            "formatString": "0.0",
            "lineageTag": "16ea2003-4162-569f-895e-0d536e9881dc"
          },
          {
            "name": "Popularidad promedio",
            "description": "Agregación de valores conocidos; nulos no se sustituyen por cero. ROI y diferencia bruta no equivalen a beneficio neto.",
            "expression": "AVERAGE('fact_peliculas'[popularity])",
            "formatString": "0.00",
            "lineageTag": "ec0d390b-cf7d-57e4-961b-da7d466b9384"
          },
          {
            "name": "Diferencia bruta total",
            "description": "Agregación de valores conocidos; nulos no se sustituyen por cero. ROI y diferencia bruta no equivalen a beneficio neto.",
            "expression": "SUM('fact_peliculas'[gross_difference])",
            "formatString": "$#,0;($#,0);$0",
            "lineageTag": "a7517171-f448-5805-92e6-59e269b6367a"
          },
          {
            "name": "ROI promedio",
            "description": "Agregación de valores conocidos; nulos no se sustituyen por cero. ROI y diferencia bruta no equivalen a beneficio neto.",
            "expression": "AVERAGE('fact_peliculas'[roi_approx])",
            "formatString": "0.0%",
            "lineageTag": "29de1860-af4e-5321-890e-95ca96828a1d"
          },
          {
            "name": "Películas",
            "expression": "DISTINCTCOUNT(fact_peliculas[pelicula_key])",
            "formatString": "#,0",
            "lineageTag": "9ae2271a-7371-5b3d-8531-41ad058556e4"
          },
          {
            "name": "Con presupuesto",
            "expression": "COUNT(fact_peliculas[budget])",
            "formatString": "#,0",
            "lineageTag": "14f0ef39-b3e8-5f73-bdd3-91172d7ebc68"
          },
          {
            "name": "Con ingresos",
            "expression": "COUNT(fact_peliculas[revenue])",
            "formatString": "#,0",
            "lineageTag": "39782fd7-adcb-5280-af14-be1a34f9a0c1"
          },
          {
            "name": "Candidatas ML",
            "description": "Candidatas del ETL dentro del contexto, respeta el segmentador de candidata ML.",
            "expression": "COALESCE(CALCULATE([Películas], KEEPFILTERS(dim_pelicula[financial_candidate] = TRUE())), 0)",
            "formatString": "#,0",
            "lineageTag": "2749d899-11cd-5fdb-95e8-8b967c2a106c"
          },
          {
            "name": "Con dato: budget",
            "expression": "COUNT(fact_peliculas[budget])",
            "formatString": "#,0",
