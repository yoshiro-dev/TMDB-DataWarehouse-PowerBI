	column roi_approx
		dataType: double
		lineageTag: 2f250e10-16d0-59ee-bf35-1d9f5b15b39e
		summarizeBy: none
		sourceColumn: roi_approx

	/// Reglas exploratorias: presupuesto positivo menor a 1000 o >=300 millones; ingreso positivo <=100 o >=5 mil millones; ROI >=100 (10,000%); presupuesto igual a ingreso. Sin alertas no significa verificado. No se exige tener ambos importes.
	column calidad_financiera
		dataType: string
		lineageTag: 43035acc-7d8a-5b6c-a387-b2026644ca2d
		summarizeBy: none
		sourceColumn: calidad_financiera

	partition fact_peliculas = m
		mode: import
		source =
				let
				    Origen = Parquet.Document(File.Contents(RutaParquet & "\fact_peliculas.parquet")),
				    Tipos = Table.TransformColumnTypes(Origen, {{"pelicula_key", Int64.Type}, {"fecha_key", Int64.Type}, {"budget", Int64.Type}, {"revenue", Int64.Type}, {"vote_average", type number}, {"vote_count", Int64.Type}, {"runtime", Int64.Type}, {"popularity", type number}, {"gross_difference", Int64.Type}, {"roi_approx", type number}}),
				    Clasificacion = Table.AddColumn(Tipos, "calidad_financiera", each if ([budget] <> null and ([budget] < 1000 or [budget] >= 300000000)) or ([revenue] <> null and ([revenue] <= 100 or [revenue] >= 5000000000)) or ([roi_approx] <> null and [roi_approx] >= 100) or ([budget] <> null and [revenue] <> null and [budget] = [revenue]) then "Revisar" else if [budget] = null and [revenue] = null then "Sin importes" else "Sin alertas detectadas", type text)
				in
				    Clasificacion

	annotation PBI_ResultType = Table

